<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · Snatcher</title>
  <meta name="description" content="<%= description %>" />
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex" />
  <% } %><% if (typeof canonical !== 'undefined') { %><link rel="canonical" href="<%= canonical %>" />
  <% } %><meta property="og:title" content="<%= title %> · Snatcher" />
  <meta property="og:description" content="<%= description %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Snatcher" />
  <meta property="og:locale" content="en_US" />
  <% if (typeof canonical !== 'undefined') { %><meta property="og:url" content="<%= canonical %>" />
  <% } %><meta property="og:image" content="<%= siteUrl %>/og.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title %> · Snatcher" />
  <meta name="twitter:description" content="<%= description %>" />
  <meta name="twitter:image" content="<%= siteUrl %>/og.jpg" />
  <meta name="theme-color" content="#f7f4ee" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>" />
  <% if (typeof jsonLd !== 'undefined') { %><% for (const block of jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(block) %></script>
  <% } %><% } %></head>
