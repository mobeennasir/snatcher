<%- include('partials/head', { title: page.title, description: page.description }) %>
<body data-page="legal">
<%- include('partials/icons') %>
<%- include('partials/header', { platforms }) %>
<main>
  <section class="section legal">
    <div class="container">
      <a class="back-link" href="/">
        <svg aria-hidden="true"><use href="#i-arrow-left" /></svg>
        Back to Snatcher
      </a>
      <h1><%= page.title %></h1>
      <p class="lede"><%= page.intro %></p>
      <% for (const section of page.sections) { %>
      <h2><%= section.heading %></h2>
      <% for (const para of section.paragraphs) { %><p><%- para %></p>
      <% } %><% if (section.bullets) { %><ul>
        <% for (const item of section.bullets) { %><li><%= item %></li>
        <% } %></ul>
      <% } %><% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
